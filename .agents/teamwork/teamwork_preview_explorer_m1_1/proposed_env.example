# ==============================================================================
# Simula-AI Environment Configuration Template
# Copy this file to .env and fill in required values: cp .env.example .env
# ==============================================================================

# OpenRouter API Key (Required for live generation)
# Obtain from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter API Endpoint (Defaults to standard OpenRouter API)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Primary Reasoning Model for Code & Test Generation
OPENROUTER_MODEL=deepseek/deepseek-r1

# Fallback Model used on HTTP 429 Rate Limiting
OPENROUTER_FALLBACK_MODEL=deepseek/deepseek-chat

# Cognitive Loop Limits & Sandbox Security
SIMULA_MAX_ITERATIONS=5
SIMULA_SANDBOX_TIMEOUT_SECONDS=30
SIMULA_LOG_LEVEL=INFO

# Streamlit Web UI Configuration
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0
STREAMLIT_SERVER_HEADLESS=true

# Mock Mode (Set to "true" for offline CI/CD and unit testing without token costs)
SIMULA_MOCK_LLM=false
